# ── Client (Vite). These are public: they end up in the browser bundle. ──
# Leave both empty to run the offline demo backend (no Supabase needed).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Launch day: worksheet No. 1, where the archive starts (YYYY-MM-DD).
# Defaults to 2026-11-16.
VITE_LAUNCH_DATE=

# ── Edge Function secrets. NEVER put these in a VITE_ variable. ──
# Set them with `supabase secrets set NAME=value`, not in this file, in production.
# Key for the 100 AI ghost players per question (Claude). Without it, every
# question gets 1,100 rule-based ghosts instead of 1,000 + 100 AI.
ANTHROPIC_API_KEY=
# Password for the /admin page.
ADMIN_SECRET=
# Shared between pg_cron and the prepare-day function (also stored in Vault as outlier_cron_secret).
CRON_SECRET=
